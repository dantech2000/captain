# The tools Captain.app ships with. scripts/fetch-tools.sh reads this file.
# See docs/features/0021-packaging.md before you change a version.

LIMA_VERSION=2.2.0
DOCKER_VERSION=29.8.1
COMPOSE_VERSION=5.5.1
BUILDX_VERSION=0.37.1

# download.docker.com publishes no checksum files, so the static docker CLI
# archives are pinned here. Update them with:
#   curl -fsSL https://download.docker.com/mac/static/stable/<arch>/docker-<version>.tgz | shasum -a 256
DOCKER_SHA256_DARWIN_ARM64=5a8f5604d7673202b2af925229d15eb4bbb86f7f542e4ac8cd7aa3f14cfa0f8b
DOCKER_SHA256_DARWIN_X86_64=de42b6bb38d0ea08333cdddc18b054d61d4c9f003b3616ae55d85ccea72c47c9

# docker-credential-osxkeychain, for "credsStore": "osxkeychain" in config.json.
# The sums come from the release's checksums.txt:
#   https://github.com/docker/docker-credential-helpers/releases/download/v<version>/checksums.txt
CREDENTIAL_HELPERS_VERSION=0.9.9
OSXKEYCHAIN_SHA256_DARWIN_ARM64=3585188b1df1c3568ae536999eddb48ad2c781b3cf07a2f7d7181262d045820c
OSXKEYCHAIN_SHA256_DARWIN_X86_64=1be33ae30c8c80277bea3364d0d71afad411fa22e88bcabf3375550b989fd272
